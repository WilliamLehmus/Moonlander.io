# Moonlander.io Environment Variables Example
# Copy this file to '.env' and adjust values as needed for local development or deployment.

# Server Port (Default: 3010)
PORT=3010

# Environment Mode ('development' or 'production')
# In 'production', the backend serves static frontend assets from client/dist
NODE_ENV=development

# Frontend Socket Server URL (for local dev when client runs on Vite port e.g. 5173)
VITE_SERVER_URL=http://localhost:3010
